PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
ANTHROPIC_API_KEY=

# Optional — lets an admin trigger an offsite database backup to Dropbox from the app
# itself (Manage Members / Audit Log / Backups). Without it, that button shows a
# "not configured" message; local backups (server/backup.js) still work either way.
# Generate at https://www.dropbox.com/developers/apps — see README for setup steps.
DROPBOX_ACCESS_TOKEN=
# Optional — defaults to /Personal/Family Office/RFO Backup (matches the family's
# existing local Dropbox-synced backup folder).
DROPBOX_BACKUP_PATH=
